{
  "name": "fig-work-logger",
  "version": "1.0.0",
  "description": "피그마 작업 내용을 로컬 파일로 기록하는 플러그인",
  "scripts": {
    "build": "webpack --mode production",
    "watch": "webpack --watch --mode development",
    "server": "node server/index.js",
    "dev": "concurrently \"npm run watch\" \"npm run server\"",
    "build-server": "pkg server/index.js --targets node18-win-x64 --output installer/work-logger-server.exe"
  },
  "pkg": {
    "scripts": "server/index.js",
    "targets": ["node18-win-x64"],
    "outputPath": "installer"
  },
  "devDependencies": {
    "@figma/plugin-typings": "*",
    "@yao-pkg/pkg": "^5.12.0",
    "concurrently": "^8.2.0",
    "ts-loader": "^9.5.0",
    "typescript": "^5.3.0",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.0"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.0"
  }
}
